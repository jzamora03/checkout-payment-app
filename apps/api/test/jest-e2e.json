{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/test/jest.setup.ts"],
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/main.ts",
    "!src/test/**",
    "!src/**/*.spec.ts"
  ],
  "coverageDirectory": "coverage/e2e",
  "coverageThreshold": {
    "global": {
      "lines": 80,
      "statements": 80,
      "branches": 70,
      "functions": 80
    }
  }
}