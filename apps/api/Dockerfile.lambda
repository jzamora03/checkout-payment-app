# Multi-stage build para ejecutar la API NestJS en AWS Lambda
# Usa la imagen base oficial de AWS Lambda para Node 20.

FROM public.ecr.aws/lambda/nodejs:20 AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npx prisma generate
RUN npm run build

FROM public.ecr.aws/lambda/nodejs:20
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY package*.json ./

# El runtime de Lambda invoca el handler exportado (serverless-express).
CMD ["/app/dist/src/serverless.handler"]
